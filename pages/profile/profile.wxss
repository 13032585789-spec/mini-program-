.profile-page{padding-top:20rpx}.user-card{padding:28rpx;display:flex;align-items:center}.big-avatar{width:100rpx;height:100rpx;background:#FFD43B;border-radius:30rpx;display:flex;align-items:center;justify-content:center;font-size:37rpx;font-weight:800}.user-info{flex:1;margin-left:22rpx}.user-info>view{font-size:34rpx;font-weight:730}.user-info>view text{font-size:18rpx;color:#2B8963;background:#E7F6EE;padding:6rpx 10rpx;border-radius:8rpx;margin-left:9rpx;vertical-align:6rpx}.user-info>text{font-size:23rpx;color:#9f9a90;display:block;margin-top:9rpx}.arrow{font-size:42rpx;color:#bbb7ae}.achievement{display:flex;padding:30rpx 15rpx;margin-bottom:32rpx}.achievement view{flex:1;text-align:center;border-right:1rpx solid #E5E3DE}.achievement view:last-child{border:0}.achievement text{display:block;font-size:36rpx;font-weight:750}.achievement small{font-size:21rpx;color:#9f9a90}.section-label{font-size:23rpx;color:#99958c;margin:24rpx 5rpx 13rpx}.menu{padding:2rpx 24rpx}.menu-item{display:flex;align-items:center;min-height:92rpx;border-bottom:1rpx solid #F0EFEA}.menu-item:last-child{border:0}.menu-icon{width:50rpx;height:50rpx;border-radius:15rpx;display:flex;align-items:center;justify-content:center;font-size:21rpx;font-weight:700;margin-right:18rpx}.yellow-bg{background:#FFF3C4;color:#9C7000}.green-bg{background:#E5F5ED;color:#287E5D}.blue-bg{background:#E8F0FF;color:#4A74B8}.orange-bg{background:#FFF0E0;color:#C67B00}.menu-item>text{flex:1;font-weight:600}.menu-item>small{font-size:22rpx;color:#aaa59b;margin-right:15rpx}.menu-item>view:last-child{color:#bbb7ae;font-size:34rpx}.menu-item switch{transform:scale(.75)}.wechat{margin-top:35rpx;background:#fff;color:#4B8F6D;border:0;border-radius:20rpx;font-size:25rpx}.wechat::after{border:0}.version{text-align:center;color:#b3afa6;font-size:20rpx;margin:30rpx 0}
