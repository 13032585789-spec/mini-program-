.compose-page{text-align:center}.check-mark{width:116rpx;height:116rpx;border-radius:50%;background:#FFD43B;margin:15rpx auto 20rpx;display:flex;align-items:center;justify-content:center;font-size:55rpx;font-weight:800;box-shadow:0 12rpx 30rpx rgba(218,170,0,.2)}.compose-title{font-size:39rpx;font-weight:750}.compose-sub{font-size:24rpx;color:#9e998f;margin:12rpx 0 34rpx}.input-card{text-align:left;padding:25rpx}.input-card textarea{width:100%;height:230rpx;font-size:28rpx;line-height:1.6}.counter{text-align:right;color:#b5b0a7;font-size:21rpx}.photos{display:flex;gap:16rpx;margin:22rpx 0 30rpx}.photo,.add-photo{width:145rpx;height:145rpx;border-radius:22rpx;overflow:hidden}.photo image{width:100%;height:100%}.add-photo{border:2rpx dashed #D4CFC4;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#918b80}.add-photo text{font-size:42rpx}.add-photo view{font-size:21rpx}.privacy{display:flex;text-align:left;align-items:center;padding:24rpx}.privacy>view{flex:1}.privacy text{font-weight:650;display:block}.privacy small{font-size:21rpx;color:#aaa59b;margin-top:6rpx;display:block}.privacy switch{transform:scale(.8)}.submit{height:96rpx;line-height:96rpx;margin-top:40rpx}.penalty-tip{font-size:21rpx;color:#aaa49a;margin-top:18rpx}
