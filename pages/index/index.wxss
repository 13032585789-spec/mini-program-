.topbar { display:flex; align-items:center; justify-content:space-between; margin: 10rpx 2rpx 30rpx; }
.hello { font-size: 42rpx; font-weight: 760; margin-top: 8rpx; }
.hero { padding: 34rpx; background: linear-gradient(145deg,#fffdf3,#fff); overflow:hidden; border: 1rpx solid #FFF3BC; }
.hero-head { display:flex; justify-content:space-between; gap:20rpx; }
.hero-title { font-size: 36rpx; font-weight: 760; margin-top:22rpx; max-width:390rpx; line-height:1.35; }
.ring { width:132rpx; height:132rpx; border-radius:50%; border:10rpx solid #FFD43B; display:flex; flex-direction:column; align-items:center; justify-content:center; flex-shrink:0; box-shadow: inset 0 0 0 5rpx #FFF7D1; }
.ring text { font-size:30rpx; font-weight:750; }.ring view { font-size:19rpx; color:#999083; }.ring.done { background:#FFD43B; }
.rule { margin:30rpx 0 25rpx; padding:20rpx; background:#FFF9E5; border-radius:18rpx; color:#746740; font-size:25rpx; }
.rule-icon { display:inline-flex; width:34rpx;height:34rpx;align-items:center;justify-content:center;background:#FFD43B;border-radius:50%;font-weight:bold;margin-right:9rpx; }.strong{color:#3a321d;font-weight:700}
.checkin-btn { height:96rpx; line-height:96rpx; background:#FFD43B; border-radius:24rpx; font-weight:750; font-size:31rpx; box-shadow:0 12rpx 24rpx rgba(232,180,0,.18); }.checkin-btn::after{border:0}
.streak{text-align:center;color:#8d877a;font-size:24rpx;margin-top:20rpx}.streak text{font-weight:750;color:#202018}
.section-head{display:flex;justify-content:space-between;align-items:center;margin:38rpx 4rpx 20rpx}.members{display:flex;align-items:center}.members .mini-avatar{margin-left:-12rpx;border:4rpx solid #F7F7F5}.members text{font-size:22rpx;color:#969187;margin-left:10rpx}
.mini-avatar{width:52rpx;height:52rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20rpx;font-weight:700}.mini-avatar.large{width:66rpx;height:66rpx;font-size:24rpx}
.feed{padding:26rpx;margin-bottom:18rpx}.feed-head{display:flex;align-items:center}.feed-who{margin-left:18rpx;flex:1}.feed-who text{font-weight:700}.feed-who view{font-size:22rpx;color:#aaa59b;margin-top:4rpx}.success{font-size:21rpx;color:#2D8B63;background:#E9F7F0;padding:8rpx 14rpx;border-radius:99rpx}.feed-text{margin:22rpx 4rpx;line-height:1.65}.feed-actions{border-top:1rpx solid #F2F0EB;padding-top:18rpx;color:#aaa49a;font-size:24rpx}.feed-actions text{margin-right:38rpx}.ledger-head{margin-top:42rpx}.more{font-size:24rpx;color:#aaa49a}
.records{padding:4rpx 26rpx}.record{display:flex;align-items:center;padding:25rpx 0;border-bottom:1rpx solid #F1F0EC}.record:last-child{border:0}.record-icon{width:64rpx;height:64rpx;border-radius:19rpx;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:32rpx}.record-icon.penalty{background:#FFF1D6;color:#E29400}.record-icon.income{background:#EAF7F0;color:#389069}.record-main{flex:1;margin-left:18rpx}.record-main>text{font-weight:650}.record-main view{font-size:21rpx;color:#aaa49a;margin-top:7rpx}.amount{font-weight:750}.amount.penalty{color:#E69D00}.amount.income{color:#33936B}
