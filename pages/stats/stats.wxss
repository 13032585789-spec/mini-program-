.stats-head{display:flex;justify-content:space-between;align-items:center;margin:10rpx 2rpx 26rpx}.date-switch{background:#fff;padding:15rpx 21rpx;border-radius:16rpx;font-size:25rpx}.tabs{background:#EDECE8;border-radius:18rpx;padding:6rpx;display:flex;margin-bottom:22rpx}.tabs view{flex:1;text-align:center;padding:17rpx;color:#969188;border-radius:13rpx}.tabs .active{background:#fff;color:#222018;font-weight:700;box-shadow:0 4rpx 12rpx rgba(40,35,20,.05)}.summary{padding:30rpx}.summary-label{color:#99958c;font-size:24rpx}.summary-money{font-size:65rpx;font-weight:780;margin-top:6rpx}.summary-money text{font-size:29rpx;margin-right:6rpx}.compare{display:inline-block;background:#EAF7EF;color:#338762;padding:8rpx 13rpx;border-radius:10rpx;font-size:21rpx}.chart{height:285rpx;display:flex;align-items:flex-end;gap:18rpx;margin-top:24rpx;border-bottom:1rpx solid #EEECE7}.bar-wrap{height:100%;flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;position:relative}.bar{width:35rpx;background:#FFD43B;border-radius:10rpx 10rpx 3rpx 3rpx;min-height:8rpx}.bar-wrap text{font-size:20rpx;color:#aaa49b;margin:12rpx 0}.bar-value{position:absolute;top:4rpx;font-size:18rpx;color:#8a826e}.metrics{display:flex;gap:18rpx;margin:22rpx 0 36rpx}.metric{flex:1;padding:25rpx}.metric-icon{width:47rpx;height:47rpx;border-radius:14rpx;display:flex;align-items:center;justify-content:center;font-weight:bold;margin-bottom:17rpx}.sun{background:#FFF4C4;color:#B47C00}.alert{background:#FFF0E1;color:#D38400}.metric>text{font-size:40rpx;font-weight:750}.metric>view:not(.metric-icon){font-size:25rpx;margin-top:4rpx}.metric small{display:block;color:#aaa49b;font-size:20rpx;margin-top:8rpx}.section-head{display:flex;justify-content:space-between;align-items:center;margin:0 3rpx 18rpx}.section-head>text{font-size:22rpx;color:#aaa49b}.ranking{padding:5rpx 24rpx}.rank{display:flex;align-items:center;padding:22rpx 0;border-bottom:1rpx solid #F0EFEA}.rank:last-child{border:0}.num{width:35rpx;color:#aaa49b;font-weight:700}.rank-avatar{width:63rpx;height:63rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;margin-right:17rpx}.rank-info{flex:1}.rank-info>text{font-weight:650}.rank-info small{font-size:18rpx;color:#B77B00;background:#FFF4C4;padding:4rpx 8rpx;border-radius:7rpx}.progress{height:8rpx;background:#EFEDE8;border-radius:8rpx;margin-top:12rpx;overflow:hidden}.progress view{height:100%;background:#FFD43B;border-radius:8rpx}.rate{font-weight:700;margin-left:18rpx}
