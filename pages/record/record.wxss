.type-tabs{display:flex;background:#EBEAE5;padding:6rpx;border-radius:19rpx}.type-tabs view{flex:1;padding:18rpx 6rpx;text-align:center;border-radius:14rpx;color:#918c82;font-size:24rpx}.type-tabs .active{background:#fff;color:#201e17;font-weight:700;box-shadow:0 4rpx 14rpx rgba(30,25,10,.06)}.amount-box{text-align:center;padding:55rpx 0 42rpx}.amount-box>text{font-size:40rpx;font-weight:700;vertical-align:25rpx}.amount-box input{display:inline-block;width:280rpx;height:110rpx;font-size:88rpx;font-weight:760;text-align:left}.amount-box small{display:block;color:#99948b;font-size:22rpx}.field{margin-top:30rpx}.field label,.field-row label{display:block;font-size:23rpx;color:#878278;margin:0 5rpx 12rpx}.field textarea{width:100%;height:180rpx;background:#fff;border-radius:22rpx;padding:23rpx;line-height:1.55}.field-row{display:flex;gap:18rpx;margin-top:25rpx}.field-row>view{flex:1}.select{background:#fff;border-radius:18rpx;padding:23rpx;font-weight:600;font-size:24rpx}.upload{display:flex;align-items:center;background:#fff;border-radius:20rpx;padding:25rpx;margin-top:26rpx}.upload>text{font-size:31rpx;margin-right:17rpx}.upload>view{flex:1}.upload small{font-size:22rpx;color:#aaa59b}.preview{width:150rpx;height:150rpx;border-radius:18rpx;margin-top:16rpx}.save{height:96rpx;line-height:96rpx;margin-top:50rpx}
